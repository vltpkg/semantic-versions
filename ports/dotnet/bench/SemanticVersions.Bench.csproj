<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Benchmarks SemanticVersions against Semver (maxhauser) and SemanticVersioning (a node-semver
    port). From ports/dotnet:  dotnet run -c Release -project bench   (add -quick for a fast run)

    Set VendorDir to compile the comparison libraries from source checkouts instead of NuGet.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;CS8632;CS0618;CA1510;CA1512;CA1513</NoWarn>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/SemanticVersions/SemanticVersions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(VendorDir)' == ''">
    <PackageReference Include="Semver" Version="3.0.0" />
    <PackageReference Include="SemanticVersioning" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(VendorDir)' != ''">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="$(VendorDir)/maxhauser-semver/Semver/**/*.cs" Exclude="$(VendorDir)/maxhauser-semver/Semver/obj/**" />
    <Compile Include="$(VendorDir)/semver.net/src/SemanticVersioning/**/*.cs" Exclude="$(VendorDir)/semver.net/src/SemanticVersioning/obj/**;$(VendorDir)/semver.net/src/SemanticVersioning/Properties/**" />
  </ItemGroup>

</Project>
