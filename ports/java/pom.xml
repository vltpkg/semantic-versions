<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.vlt</groupId>
  <artifactId>semantic-versions</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>semantic-versions</name>
  <description>Parse, compare and match versions per the Semantic Versions specification (semver.xyz)</description>
  <url>https://semver.xyz/libraries/#java</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <organization>vlt technology inc.</organization>
      <organizationUrl>https://vlt.sh</organizationUrl>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/vltpkg/semantic-versions</url>
    <connection>scm:git:https://github.com/vltpkg/semantic-versions.git</connection>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <!-- The conformance suite is a dependency-free main class (see README). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>conformance</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.vlt.semanticversions.ConformanceTest</mainClass>
              <classpathScope>test</classpathScope>
              <arguments><argument>${project.basedir}/../../conformance</argument></arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <executions>
          <execution><id>attach-javadocs</id><goals><goal>jar</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
