{
    "name": "vltpkg/semantic-versions",
    "description": "Parse, compare and match versions per the Semantic Versions specification (semver.xyz)",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["semver", "semantic versioning", "version", "range", "npm"],
    "homepage": "https://semver.xyz/libraries/#php",
    "support": {
        "source": "https://github.com/vltpkg/semantic-versions/tree/main/ports/php",
        "docs": "https://semver.xyz/spec/"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "composer/semver": "^3.4",
        "z4kn4fein/php-semver": "^3.0"
    },
    "autoload": {
        "psr-4": { "Vlt\\SemanticVersions\\": "src/" }
    },
    "scripts": {
        "test": "php tests/conformance.php",
        "bench": "php bench/compare.php"
    }
}
