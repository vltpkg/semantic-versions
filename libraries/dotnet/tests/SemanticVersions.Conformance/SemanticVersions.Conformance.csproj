<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the shared conformance suite; dependency-free (exit code 1 on failure). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SemanticVersions/SemanticVersions.csproj" />
  </ItemGroup>

</Project>
