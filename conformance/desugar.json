{
  "description": "Advanced range syntax and its primitive comparators, from the specification. `output` is the desugared range as the spec writes it; `accept` lists equivalent forms (a redundant `>=0.0.0` lower bound may be omitted).",
  "cases": [
    {
      "category": "ranges",
      "input": "1.2.3 - 2.3.4",
      "output": ">=1.2.3 <=2.3.4"
    },
    {
      "category": "ranges",
      "input": "1.2 - 2.3.4",
      "output": ">=1.2.0 <=2.3.4"
    },
    {
      "category": "ranges",
      "input": "1.2.3 - 2.3",
      "output": ">=1.2.3 <2.4.0-0"
    },
    {
      "category": "ranges",
      "input": "1.2.3 - 2",
      "output": ">=1.2.3 <3.0.0-0"
