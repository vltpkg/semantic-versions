{
  "description": "Range membership. `expected` says whether `version` satisfies `range`.",
  "cases": [
    {
      "category": "ranges",
      "range": "1.0.0 - 2.0.0",
      "version": "1.2.3",
      "expected": true
    },
    {
      "category": "build-channels",
      "range": "^1.2.3+build",
      "version": "1.2.3",
      "expected": false,
      "note": "a build on a range is a channel filter"
    },
    {
      "category": "build-channels",
      "range": "^1.2.3+build",
      "version": "1.3.0",
      "expected": false,
      "note": "a build on a range is a channel filter"
    },
    {
      "category": "ranges",
      "range": "1.2.3-pre+asdf - 2.4.3-pre+asdf",
      "version": "1.2.3",
      "expected": true
    },
    {
      "category": "strict",
      "range": "1.2.3pre+asdf - 2.4.3-pre+asdf",
      "version": "1.2.3",
      "expected": false,
      "note": "loose forms are not versions"
    },
    {
      "category": "strict",
      "range": "1.2.3-pre+asdf - 2.4.3pre+asdf",
      "version": "1.2.3",
      "expected": false,
